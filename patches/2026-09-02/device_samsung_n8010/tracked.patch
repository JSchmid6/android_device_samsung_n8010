-	wifi.supplicant_scan_interval=240
\ No newline at end of file
+	wifi.supplicant_scan_interval=240
+# Debug-Instrumentierung fuer den surfaceflinger-Absturz (Build 31)
+# - logd schreibt avc-Meldungen sonst selbst nach /dev/kmsg (LogAudit.cpp,
+#   Praefix <38>). flags_health_check erzeugt ~100 davon pro Sekunde und
+#   ueberschreibt den 1-MB-Kernelpuffer in ~15 s. Der Kernel-Parameter audit=0
+#   greift dagegen nicht.
+# - logcatd persistiert alle Puffer (main/system/crash/kernel) nach
+#   /data/misc/logd/logcat*, 32 x 2 MB.
+PRODUCT_PROPERTY_OVERRIDES += \
+	ro.logd.auditd.dmesg=false \
+	persist.logd.logpersistd=logcatd \
+	persist.logd.logpersistd.size=32
