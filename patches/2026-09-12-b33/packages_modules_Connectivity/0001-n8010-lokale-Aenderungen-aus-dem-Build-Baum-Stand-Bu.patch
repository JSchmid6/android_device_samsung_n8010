From 72f3ae638bce59af9e112d09e30b0ed24ff83483 Mon Sep 17 00:00:00 2001
From: Jochen Schmid <Jochen@wejos.de>
Date: Sat, 12 Sep 2026 20:22:40 +0200
Subject: [PATCH 01/15] n8010: lokale Aenderungen aus dem Build-Baum (Stand
 Build 32)

Change-Id: I05685c3b6df1a48e4e0339d3ba522b39929cd7c3
---
 netbpfload/netbpfload.mainline.rc | 13 ++++++++++++-
 netbpfload/netbpfload.rc          | 24 ++++++++++++++++++++++--
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/netbpfload/netbpfload.mainline.rc b/netbpfload/netbpfload.mainline.rc
index 0ac5de8b97..ce5c5c6d25 100644
--- a/netbpfload/netbpfload.mainline.rc
+++ b/netbpfload/netbpfload.mainline.rc
@@ -4,5 +4,16 @@ service bpfloader /apex/com.android.tethering/bin/netbpfload
     user root
     rlimit memlock 1073741824 1073741824
     oneshot
-    reboot_on_failure reboot,bpfloader-failed
+    # N8010 COMPAT: reboot_on_failure entfernt (GT-N8010, armv7, Kernel 3.4.67).
+    #
+    # netbpfload kann auf 32-bit ARM nicht erfolgreich durchlaufen: der ARM32-BPF-JIT
+    # implementiert die atomaren Opcodes nicht, die Androids BPF-Programme benutzen
+    # ("*** NOT YET: opcode c3 ***" im Verifier-Log). Auf Kernel 3.4 fehlt ohnehin
+    # CONFIG_BPF_SYSCALL komplett. Mit reboot_on_failure ergibt das eine Bootschleife.
+    #
+    # WICHTIG: Diese Datei wird IM TETHERING-APEX ausgeliefert und ueberschreibt per
+    # "override" die Definition aus /system/etc/init/netbpfload.rc. Ein Patch dort
+    # bleibt wirkungslos, sobald das APEX gemountet ist — genau deshalb blieb die
+    # Bootschleife trotz auskommentiertem reboot_on_failure in /system bestehen.
+    # reboot_on_failure reboot,bpfloader-failed
     override
diff --git a/netbpfload/netbpfload.rc b/netbpfload/netbpfload.rc
index 14181dc6fc..e882542ca5 100644
--- a/netbpfload/netbpfload.rc
+++ b/netbpfload/netbpfload.rc
@@ -15,7 +15,24 @@
 # considered to have booted successfully.
 #
 on load_bpf_programs
-    exec_start bpfloader
+    # N8010 COMPAT: bpfloader wird gar nicht mehr gestartet (GT-N8010, armv7).
+    #
+    # Vorgeschichte: hier stand erst "exec_start bpfloader", dann "start bpfloader"
+    # (nicht-blockierend). Beides half nicht, weil das Problem nicht das Blockieren
+    # war, sondern dass netbpfload FEHLSCHLAEGT und das Geraet dann neu startet.
+    #
+    # netbpfload kann auf 32-bit ARM nicht durchlaufen: der ARM32-BPF-JIT hat die
+    # atomaren Opcodes nicht ("*** NOT YET: opcode c3 ***"), und Kernel 3.4 hat
+    # ohnehin kein CONFIG_BPF_SYSCALL. Ein Start kann also nur scheitern.
+    #
+    # Dieser Trigger liegt in /system und wird NICHT vom Tethering-APEX
+    # ueberschrieben — im Gegensatz zur service-Definition unten, die per
+    # "override" aus netbpfload.mainline.rc im APEX ersetzt wird. Deshalb ist das
+    # hier die Stelle, an der ein Patch tatsaechlich wirkt.
+    #
+    # Folge: kein BPF-basiertes Traffic-Accounting. Auf diesem Geraet ohnehin
+    # nicht erreichbar.
+    # start bpfloader
 
 service bpfloader /system/bin/netbpfload
     # netbpfload will do network bpf loading, then execute /system/bin/bpfloader
@@ -81,6 +98,9 @@ service bpfloader /system/bin/netbpfload
     #    'cannot prove return value is 0 or 1' or 'unsupported / unknown operation / helper',
     #    'invalid bpf_context access', etc.
     #
-    reboot_on_failure reboot,bpfloader-failed
+    # Disabled for kernel 3.0.x (Exynos4412/GT-N8010): eBPF is not supported on this kernel.
+    # netbpfload fails because /apex/com.android.tethering/bin/netbpfload does not exist
+    # on kernels without eBPF support. Making failure non-fatal allows the system to boot.
+    # reboot_on_failure reboot,bpfloader-failed
     # we're not really updatable, but want to be able to load bpf programs shipped in apexes
     updatable
-- 
2.48.1

